# Keep the ETL service's build context small — this image only needs to run
# Python extractors, not the frontend or local data (data/ lives on a Railway
# volume, never baked into the image; see Dockerfile).
.git/
data/
website/frontend/node_modules/
website/frontend/.next/
website/frontend/out/
__pycache__/
*.pyc
.DS_Store

# Secrets must never be baked into an image. `COPY . .` would otherwise carry
# .env.local into every layer of a registry image, and the file holds the
# Anthropic, OpenAI, Voyage and Postgres credentials. Railway injects the real
# environment at runtime; nothing in the image should need this file.
.env
.env.*
# Worktrees carry a `.git` FILE rather than a directory, which the `.git/`
# pattern above does not match, and a dangling symlink inside one fails the
# build with an unhelpful COPY error.
.git
.claude/

# A database backup must no more enter an image than a credential does. This
# directory is 123 MB of verified Postgres dumps (ETL/lib/backup_postgres.py),
# untracked and, until now, matched by nothing here -- so `COPY . .` would have
# baked it into every layer, more than doubling a 77 MB build context and
# putting a full copy of the corpus in a registry. Railway mounts the real data
# on a volume; nothing in this image should ever read a backup.
postgres-backup/
