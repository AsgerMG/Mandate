# Copy to .env.local (gitignored) and fill in real values.
# Loaded automatically by ETL/lib/etl_env.py (Python side, on import) and by
# Next.js's own env handling (website/frontend/.env.local, separate file).

# Required for all LLM extraction/classification work (Sonnet 5).
ANTHROPIC_API_KEY=

# Used for a small number of embedding/classification tasks.
OPENAI_API_KEY=

# Railway Postgres (the eligibility subsystem's live read path). Leave
# unset locally to keep using the SQLite + static-JSON fallback path.
DATABASE_URL=

# Voyage AI (embeddings for the eligibility RAG layer, ETL/terms/embed_eligibility.py).
VOYAGE_KEY=

# --- Operational (added 2026-07-28/29) ---------------------------------------

# Salt for the per-IP hash in the request quota (lib/intelligence/quota.ts).
# IPs are never stored in the clear: counting requests from a source does not
# require knowing the source. Any stable random string; changing it resets
# every in-flight rate-limit window, which is harmless.
IP_HASH_SALT=change-me

# Set to 1 to make the free check scripts read the committed
# instrument_terms.json snapshot instead of live Postgres. CI sets this so the
# checks are hermetic and cannot be broken by the state of a database.
# Not read by the application itself.
NO_PG=

