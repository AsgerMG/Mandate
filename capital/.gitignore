__pycache__/
*.pyc
*.pyo
data/backups/
.DS_Store

# Claude Code config — per-user local state is ignored, but the agent harness
# (agents, skills, slash commands, hooks) is shared project infrastructure and IS tracked.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/commands/
!.claude/hooks/

# SQLite database is a generated build artifact, never committed (330MB+,
# exceeds GitHub's 100MB limit). Rebuilt by the ETL pipeline + backed up separately.
# Covers the DB in data/ and its WAL/SHM sidecar files.
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/db.sqlite

# Source data: raw API/HTML caches and derived intermediates are generated build
# artifacts (600MB+), not version-controlled. They are reproducible by re-running
# ETL/extract/extract_*.py and are backed up separately (see README, backup strategy).
# The website never reads these; it only reads website/frontend/public/data/*.json.
data/raw/
data/processed/

# Playwright browser binary cache
.playwright/

# Local secrets (never commit)
.env
.env.local
.env.*
!.env.example

# local debugging scratch
website/frontend/.scratch/
