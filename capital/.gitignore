__pycache__/
*.pyc
*.pyo
db_backups/
.DS_Store

# Claude Code config — per-user, not project state
.claude/

# SQLite database is a generated build artifact, never committed (330MB+,
# exceeds GitHub's 100MB limit). Rebuilt from scripts/ + backed up separately.
# Covers the root DB, the stale scripts/ copy, and the WAL/SHM sidecar files.
*.sqlite
*.sqlite-wal
*.sqlite-shm
db.sqlite
scripts/db.sqlite

# Source data: raw API/HTML caches and derived intermediates are generated build
# artifacts (600MB+), not version-controlled. They are reproducible by re-running
# scripts/extract_*.py and are backed up separately (see README, backup strategy).
# The website never reads these; it only reads site/public/data/*.json.
data/raw/
data/processed/

# Playwright browser binary cache
.playwright/
