{
  "name": "wincent-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "prebuild": "python3 ../build/build_site_data.py --check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "vocab": "npx tsx scripts/emit_vocabulary.ts",
    "check": "npx tsc --noEmit && npx tsx scripts/check_vocabularies.ts && npx tsx scripts/check_archetypes.ts && npx tsx scripts/check_payload_budget.ts",
    "trace": "npx tsx scripts/trace_pool.ts",
    "board": "npx tsx scripts/bench_report.ts",
    "bench": "npx tsx scripts/memo_bench.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@base-ui/react": "^1.5.0",
    "@tremor/react": "^3.18.7",
    "@types/topojson-client": "^3.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
