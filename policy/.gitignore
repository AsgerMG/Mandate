# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Env / secrets
.env
*.local

# Persistent local embedded database (DATABASE_URL=local)
.localdb/

# Corpus export (materialized view of the DB; regenerate with `regina export`)
exports/

# brief-improve raw JSON sidecars and ad-hoc eval artifacts — full-fidelity
# data for one specific run, regenerable by re-running `regina brief-improve`;
# project-management/brief-improve-log.md is the curated, committed record.
/brief-improve-report-*.json
project-management/brief-eval-post-voyage.md
project-management/brief-eval-post-voyage.md.json

# `regina brief-check` rotation cursor + spend trail. Machine-local scratch:
# two people running the check shouldn't fight over whose turn it is, and the
# per-run JSON reports (under exports/, also ignored) hold the real record.
/.brief-check-state.json

# Node / website
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code local session config (machine-specific permissions, paths)
.claude/
