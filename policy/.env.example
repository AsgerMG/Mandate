# Copy to .env and fill in. The code reads these via pydantic-settings.

# --- Database -----------------------------------------------------------------
# Default 'local' runs a PERSISTENT embedded Postgres+pgvector under .localdb/
# with zero setup — leave it as-is to store locally.
# For a shared/durable corpus, use any Postgres with the `vector` extension:
#   Neon (recommended, pgvector built in):
#     postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
#   Local Docker (see docker-compose.yml):
#     postgresql+psycopg://regina:regina@localhost:5432/regina
DATABASE_URL=local

# --- Embeddings (used by the enrichment step, not by raw ingestion) -----------
# Production runs on Voyage (voyage-4-large, 1024-dim, hosted) as of 2026-07-21
# — fixes a real gap in the prior local model (BAAI/bge-small-en-v1.5, 384-dim,
# English-only; this corpus has real French/German content). Local fastembed
# is still supported and needs no API key — leave EMBEDDING_MODEL/DIM unset
# (or set them back to the values in the comment below) to use it instead.
# Changing EMBEDDING_MODEL/DIM requires a matching pgvector column-dimension
# migration and a full re-embed — see etl/enrichment/embeddings.py's
# VoyageEmbedder and get_embedder() before switching either value.
EMBEDDING_MODEL=voyage-4-large
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384

# --- Reranking (brief retrieval) ----------------------------------------------
# Cross-encoder second pass over embedding-search results, reusing
# VOYAGE_API_KEY above. Defaults to rerank-2.5 in code, so it is ON wherever a
# Voyage key exists and silently OFF where one doesn't (local/offline runs need
# no configuration). Unlike EMBEDDING_MODEL this stores nothing — switching it
# needs no migration and no re-embed. Set empty to disable and fall back to
# pure embedding order.
# RERANK_MODEL=rerank-2.5

# --- LLM (enrichment + later the RAG layer) -----------------------------------
# ANTHROPIC_API_KEY=

# The model that WRITES briefs. Default claude-sonnet-5. A cheaper/faster model
# is a supported swap — reasoning_params() translates the effort levels into
# whatever that model accepts — so this is safe to point at claude-haiku-4-5.
# Prefer `regina brief-check --model …` for a one-off comparison run; set it here
# only when you mean to change production.
# LLM_MODEL=claude-sonnet-5

# The model that JUDGES briefs. Deliberately separate: the judge is the measuring
# instrument, so it must not move when LLM_MODEL does, or a model comparison ends
# up scored by two different judges and incomparable with every earlier score.
# EVAL_MODEL=claude-sonnet-5

# --- API / CORS -----------------------------------------------------------------
# localhost is always allowed; add the deployed front-end's real origin(s) here
# (comma-separated) once the API is hosted somewhere the browser reaches over the
# public internet — e.g. https://regina-intel.vercel.app
# CORS_ALLOW_ORIGINS=https://regina-intel.vercel.app

# --- Ingestion tuning ---------------------------------------------------------
BACKFILL_DAYS=730
REQUEST_DELAY_SECONDS=1.0
HTTP_USER_AGENT=Regina/0.1 (+regulatory-intelligence; contact: you@example.com)
LOG_LEVEL=INFO
