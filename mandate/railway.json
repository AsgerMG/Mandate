{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "mandate/Dockerfile",
    "watchPatterns": [
      "/mandate/api/**",
      "/mandate/grounding/**",
      "/mandate/profile/**",
      "/mandate/vocabulary/**",
      "/mandate/Dockerfile",
      "/mandate/railway.json",
      "/mandate/pyproject.toml",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
