# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
memo-bench/

# ── Inherited from capital/.gitignore ──────────────────────────────────────
# This app lived at capital/website/frontend until 2026-11-06 and these rules
# reached it from capital/.gitignore. They are stated here now that it sits at
# the monorepo root, so nothing that was ignored starts showing up.
# Generated site data (website/build/build_site_data.py writes public/data/*;
# never committed, built from Postgres at prebuild).
data
*.sqlite
__pycache__/
*.pyc
.playwright/
# local debugging scratch and throwaway probes
.scratch/
scratch/
# wsN2: cached open-data pulls and derived id lists
.cache/
publishable_ids.json
harvest_candidates.json
boilerplate_verdict.json
