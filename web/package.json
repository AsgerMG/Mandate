{
  "name": "wincent-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "prebuild": "python3 ../capital/website/build/build_site_data.py --prebuild",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "vocab": "npx tsx scripts/emit_vocabulary.ts",
    "check": "node scripts/run_checks.mjs",
    "trace": "npx tsx scripts/trace_pool.ts",
    "board": "npx tsx scripts/bench_report.ts",
    "bench": "npx tsx scripts/memo_bench.ts",
    "test": "npx vitest run",
    "test:cov": "npx vitest run --coverage",
    "health": "npx tsx scripts/health_report.ts",
    "funnel": "npx tsx scripts/funnel_bench.ts",
    "stages": "npx tsx scripts/measure_funnel.ts",
    "preview:pdf": "bash scripts/preview_pdf.sh",
    "shot": "bash scripts/shot.sh",
    "redteam": "NO_PG=1 npx tsx scripts/red_team.ts",
    "drive": "node scripts/drive.mjs",
    "prodcheck": "npx tsx scripts/prodcheck.ts",
    "prodcorpus": "npx tsx scripts/check_prod_corpus.ts",
    "liveness": "npx tsx scripts/emit_liveness.ts",
    "offerroute": "npx tsx scripts/emit_offer_route.ts && npx tsx scripts/emit_offer_route_ratchet.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@base-ui/react": "^1.9.0",
    "@tremor/react": "^3.18.7",
    "@types/topojson-client": "^3.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^16.4.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0"
  }
}
